# =======================================================
# GestãoPolítica360 — Environment Configuration Example
# =======================================================

# APP & PORT
PORT=3000
NODE_ENV=production
PUBLIC_APP_URL="https://seu-gabinete.com.br"
JWT_SECRET="gerar_chave_secreta_jwt_para_producao_aqui"

# DATABASE (PostgreSQL / Hetzner Coolify)
DATABASE_URL="postgresql://usuario_db:senha_forte_db@coolify-db-host:5432/gp360_db?schema=public"

# GOOGLE GEMINI AI KEY (Assistente Político, MKT & Sentimento)
GEMINI_API_KEY="AIzaSy_Sua_Chave_Gemini_Aqui"

# RESEND API KEY (E-mail Transacional, Recibos & Mala Direta)
RESEND_API_KEY="re_Sua_Chave_Resend_Aqui"

# SENTRY OBSERVABILITY (Monitoramento de Erros e Performance)
NEXT_PUBLIC_SENTRY_DSN="https://seu_hash_sentry@o4500.ingest.sentry.io/123456"
SENTRY_AUTH_TOKEN="sntryu_Sua_Token_Sentry_Aqui"

# CLOUDFLARE (DNS, WAF & Cache)
CLOUDFLARE_ZONE_ID="seu_zone_id_cloudflare"
CLOUDFLARE_API_TOKEN="seu_api_token_cloudflare"

# COOLIFY WEBHOOK (Deploy Automatizado no Git Push)
COOLIFY_WEBHOOK_URL="https://seu-coolify.vps-hetzner.com/api/v1/deploy/webhook-id"
